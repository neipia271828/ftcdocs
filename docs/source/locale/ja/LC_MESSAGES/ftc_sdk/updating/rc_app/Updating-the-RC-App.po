#: ../../source/ftc_sdk/updating/rc_app/Updating-the-RC-App.rst
msgid "Robot Controller (RC) app on REV Control Hub"
msgstr "REV Control Hub での Robot Controller（RC）アプリ"

#: ../../source/ftc_sdk/updating/rc_app/Updating-the-RC-App.rst:76
msgid "Here are 3 methods to update the RC app on a REV Control Hub:"
msgstr "REV Control Hub で RC アプリを更新するには 3 つの方法があります："

#: ../../source/ftc_sdk/updating/rc_app/Updating-the-RC-App.rst:78
#: ../../source/ftc_sdk/updating/rc_app/Updating-the-RC-App.rst:225
msgid "REV Hardware Client (RHC)"
msgstr "REV Hardware Client (RHC)"

#: ../../source/ftc_sdk/updating/rc_app/Updating-the-RC-App.rst:79
