msgid "classifier"
msgstr "分類子"

#: ../../source/contrib/tutorials/make_rst/basic_rst_content/basic_rst_content.rst:858
msgid "Definition for term 3."
msgstr "用語3の定義。"

#: ../../source/contrib/tutorials/make_rst/basic_rst_content/basic_rst_content.rst:859
msgid "Term 4"
msgstr "用語4"

#: ../../source/contrib/tutorials/make_rst/basic_rst_content/basic_rst_content.rst:-1
